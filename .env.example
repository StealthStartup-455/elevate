# Copy this file to .env and fill in the values.
# `npm run db:start` prints the local keys.

# Local Supabase Postgres (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Local Supabase API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="paste-publishable-key-here"

# Local testing only: set to "true" to skip the login redirect on /desk and /me.
# Only works under `npm run dev`; ignored in production builds.
DEV_AUTH_BYPASS="false"
