# Copy this file to .env and fill in the values.
# `npm run db:start` prints the local keys.

# Local Supabase Postgres (used by the app and by Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Hosted only (see DEPLOYMENT.md): DATABASE_URL is the pooled connection and
# DIRECT_URL the session pooler one (port 5432), which the Prisma CLI uses for
# migrations. Not the IPv6 only "direct connection"; see DEPLOYMENT.md.
# Leave unset locally.
# DIRECT_URL=""

# Local Supabase API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="paste-publishable-key-here"

# Hosted staging only (see DEPLOYMENT.md): "true" turns on the demo login in a
# deployed build, for the demo with fictional data. Never set in production;
# APP_ENV="production" switches demo mode off even if DEMO_MODE is set.
# DEMO_MODE="true"
# APP_ENV="staging"

# Local testing only: set to "true" to skip the login redirect on /desk and /me.
# Only works under `npm run dev`; ignored in production builds.
DEV_AUTH_BYPASS="false"

# Busyness mock data: quiet, moderate or busy (see src/features/analytics/mock/).
MOCK_BUSYNESS_SCENARIO="moderate"
