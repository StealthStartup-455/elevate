#!/bin/sh
# Blocks pushes to protected branches and pushes of badly named branches.
# Input lines: <local ref> <local sha> <remote ref> <remote sha>

zero=0000000000000000000000000000000000000000
name_re='^(feature|fix|docs|refactor|chore|hotfix)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;; # tags etc. are handled by rulesets
  esac
  name=${remote_ref#refs/heads/}

  case "$name" in
    main|release|dev)
      echo "ERROR: pushing to '$name' is not allowed. Open a pull request instead." >&2
      echo "See CONTRIBUTING.md (Branch model)." >&2
      exit 1
      ;;
  esac

  # Deleting a branch: skip the name check.
  [ "$local_sha" = "$zero" ] && continue

  if ! printf '%s' "$name" | grep -Eq "$name_re"; then
    echo "ERROR: remote branch '$name' does not match <type>/<issue-number>-<short-description>." >&2
    echo "Types: feature, fix, docs, refactor, chore, hotfix. Example: feature/12-waiver-import" >&2
    echo "Push under a valid name: git push -u origin HEAD:<valid-name>" >&2
    exit 1
  fi
done

exit 0
