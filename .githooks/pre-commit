#!/bin/sh
# Blocks commits on protected branches and on branches with invalid names.
# Installed automatically by `npm install` (core.hooksPath = .githooks).
# Do not bypass with --no-verify: the same rules are enforced again by
# the pre-push hook, CI (branch-policy) and the GitHub rulesets.

branch=$(git symbolic-ref --short -q HEAD)

# Detached HEAD (mid-rebase, bisect): nothing to check.
[ -z "$branch" ] && exit 0

case "$branch" in
  main|release|dev)
    echo "ERROR: committing directly to '$branch' is not allowed." >&2
    echo "Create a branch first:" >&2
    echo "  git switch -c <type>/<issue-number>-<short-description> origin/dev" >&2
    echo "See CONTRIBUTING.md (Branch model)." >&2
    exit 1
    ;;
esac

if ! printf '%s' "$branch" | grep -Eq '^(feature|fix|docs|refactor|chore|hotfix)/[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "ERROR: branch '$branch' does not match <type>/<issue-number>-<short-description>." >&2
  echo "Types: feature, fix, docs, refactor, chore, hotfix. Example: feature/12-waiver-import" >&2
  echo "Rename it: git branch -m <new-name>" >&2
  exit 1
fi

exit 0
